load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# Applications on the Mac, in a window that is never shown, on its fixture:
# the window's title as Visor's is (the app's name with nothing open, then the
# app open), and the window as its kept pictures (Snapshots/). The app's
# sources but its @main are compiled in.
#
#   bazel test //tests/mac_tests --test_env=SNAPSHOT_COMPARE=1
#   bazel test //tests/mac_tests --strategy=TestRunner=local \
#       --test_env=SNAPSHOT_RECORD_DIR=$PWD/tests/mac_tests/Snapshots
#
# Only a login session's window server draws the sidebar: run from a plain
# SSH shell, its list is blank (and its background white) while the detail
# draws. CI builds the bundle on Linux and runs it on a slot of OS Server's
# primary Mac in its GUI session (`oss machine xctest --gui`,
# tools/ci/mac_vm_tests.sh), where it checks the titles but not the
# pictures (they compare only where CI or SNAPSHOT_COMPARE is set).
swift_library(
    name = "mac_tests_lib",
    testonly = True,
    srcs = glob(["*.swift"]) + ["//app:macos_sources_for_tests"],
    copts = STRICT_SWIFT,
    module_name = "ApplicationsMacTests",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "@swiftpkg_agent_ui//:MarkdownViews",
        "//libraries/application_updates",
        "//libraries/applications_protocol",
        "//libraries/pipeline_client",
        "//libraries/pipeline_snapshots/macos:pipeline_snapshots_macos",
    ],
)

macos_unit_test(
    name = "mac_tests",
    minimum_os_version = "15.0",
    # The kept pictures, in the test's runfiles, where MacSnapshotHost reads
    # them when it compares (bazel test on a Mac).
    data = glob(["Snapshots/*.png"], allow_empty = True),
    # Run by a Mac: on Linux, `bazel test //...` passes over it, unless it's
    # built for a Mac slot to run (//tools/ci:mac_tests_anywhere).
    target_compatible_with = select({
        "//tools/ci:build_mac_tests_anywhere": [],
        "//conditions:default": ["@platforms//os:macos"],
    }),
    deps = [":mac_tests_lib"],
)
