"""Applications: builds of our apps handed out, whatever the app —
Applications Server, which keeps them, and Applications, which puts them on
our own devices, each app's betas beside its production builds."""

module(
    name = "applications",
    version = "0.10.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "apple_support", version = "2.10.1")
# Built on Linux with rules_applecross (below): its patches to apple_support
# and rules_apple, which only a root module's overrides apply.
single_version_override(
    module_name = "apple_support",
    patch_strip = 1,
    patches = ["//third_party/patches/applecross:apple_support_bazel8_xcode_properties.patch"],
    version = "2.10.1",
)
# rules_swift from the project's registry (AttilaTheFun/bazel_registry,
# before the BCR in .bazelrc), as visor takes it: upstream's 4.1.0 with the
# wasi-threads SDK and isomer's two patches. The Apple apps build on it as
# they did on 4.1.0.
bazel_dep(name = "rules_swift", version = "4.1.0.isomer.2")
# rules_applecross asks for 4.2.2, which sorts above it: the fork all the same.
single_version_override(
    module_name = "rules_swift",
    version = "4.1.0.isomer.2",
)
# What rules_applecross's graph resolves (it was 0.2.20).
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_apple", version = "5.3.1")
# rules_applecross's patches (bundling and signing on Linux, Apple silicon by
# default off a Mac).
single_version_override(
    module_name = "rules_apple",
    patch_strip = 1,
    patches = [
        "//third_party/patches/applecross:rules_apple_execution_platform.patch",
        "//third_party/patches/applecross:rules_apple_bundletool_path.patch",
        "//third_party/patches/applecross:rules_apple_no_absolute_tool_paths.patch",
        "//third_party/patches/applecross:rules_apple_codesign_inputs_sdk_tools.patch",
        "//third_party/patches/applecross:rules_apple_alticonstool_missing_icons.patch",
        "//third_party/patches/applecross:rules_apple_xctoolrunner_sorted_listdir.patch",
        "//third_party/patches/applecross:rules_apple_arm64_default.patch",
        "//third_party/patches/applecross:rules_apple_codesign_smartcards_off_mac.patch",
        "//third_party/patches/applecross:rules_apple_app_intents_off_mac.patch",
        "//third_party/patches/applecross:rules_apple_coreml_off_mac.patch",
    ],
    version = "5.3.1",
)

# The Apple apps and the server built on Linux (a container, a VM), as
# isomer's and visor's are: rules_applecross (its clean-room actool, ibtool,
# codesign and swift-stdlib-tool, LLD), the Swift that built the Apple SDKs,
# and Xcode 27.2's SDKs, pinned by version and SHA-256. A Mac reads its own
# Xcode (local_xcode); elsewhere the SDK archive is fetched by its name
# below, a placeholder: each builder says where it is, with
# `--distdir=<folder holding apple-sdks-27.2.tar.gz>` or a
# `--downloader_config` rewriting apple-sdks.invalid to where it is served
# (an OS Server's /files/sha256/<hex>, with its read token in .netrc;
# tools/ci/container_build.sh writes one). Its ported tools come the same
# way, by their SHA-256 (third_party/applecross), from the same --distdir or
# a rewrite of ported-tools.invalid. The toolchains are registered for
# Linux alone, by the builder that has the SDKs (.bazelrc's apple_on_linux),
# so a Mac builds as before and a Linux without them builds what runs on
# Linux.
# From the project's registry: its main at a2b0558, for every module
# (rules_apple, as its patch leaves it, asks for 0.0.3, which no registry
# holds). Since 9727e5b: a Mac test's bundle built on Linux runs on a Mac
# (its run paths reach the installed Xcode's usr/lib), the Swift toolchain
# requests rules_swift's Xcode features (whole-module optimization for
# -c opt), Swift symbol graphs, and loading with rules_swift 4.1.
bazel_dep(name = "rules_applecross", version = "0.0.3.a2b0558")
single_version_override(
    module_name = "rules_applecross",
    version = "0.0.3.a2b0558",
)
apple_cross_toolchain = use_extension("@rules_applecross//toolchain:extensions.bzl", "apple_cross_toolchain")
# The Swift that built Xcode 27.2's SDKs.
apple_cross_toolchain.swift(
    name = "applecross_swift",
    platform_sha256 = {
        "ubuntu24.04": "2e9ebec040ad459dd89a6d093a02d8314939135104850fae4d5c0f174fb3ba8c",
        "ubuntu24.04-aarch64": "307772afcc0b9501faa4797eb4197076facf5768593a0d8d2b83615c95b0040e",
        # Only fetched for Swift compiles on a macOS execution platform.
        "xcode": "0a7d8489900d21dbf5f0187cb570e646a4c0226d0ddef2cbde8c7f54dfe79736",
    },
    swift_version = "6.4.2",
)
apple_cross_toolchain.configure(
    name = "apple_cross_toolchain",
    apple_sdk_urls = ["https://apple-sdks.invalid/apple-sdks-27.2.tar.gz"],
    local_xcode = True,
    ported_tools_manifest = "//third_party/applecross:ported_tools.sha256",
    ported_tools_urls = ["https://ported-tools.invalid/sha256/{sha256}"],
    swift_tools = {
        "aarch64": "@applecross_swift_ubuntu24.04-aarch64//:tools",
        "x86_64": "@applecross_swift_ubuntu24.04//:tools",
    },
    swift_tools_macos = "@applecross_swift_xcode//:tools",
    xcode_version = "27.2",
)
use_repo(apple_cross_toolchain, "apple_cross_toolchain")
# Where Apple products are bundled: on Linux with the clean-room tools, on a
# Mac with its Xcode.
register_toolchains(
    "@rules_applecross//toolchain:apple_bundling_on_linux",
    "@rules_applecross//toolchain:apple_bundling_on_macos",
)

bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")

# rules_swift_package_manager on Windows (an app's Windows build), isomer's
# patch: its SwiftPM commands keep SDKROOT (Swift on Windows finds its SDK
# by it alone), SwiftPM's JSON paths take slashes, and it reads packages with
# Git's POSIX tools, ahead of Windows' own FIND.
single_version_override(
    module_name = "rules_swift_package_manager",
    patch_strip = 1,
    patches = ["//third_party/patches:rules_swift_package_manager_windows.patch"],
)

# SwiftPM packages (swift_sql, agent_ui), pinned in third_party/swift_packages.
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//third_party/swift_packages:Package.resolved",
    swift = "//third_party/swift_packages:Package.swift",
)
# The packages' targets are told where SwiftUI and Foundation come from:
# isomer's labels, Apple's own on Apple platforms (nothing to link) and
# Isomer's on the web and Android.
swift_deps.configure_package(
    name = "agent_ui",
    target_deps = {
        "MarkdownViews": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
        "MessagesCore": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
        "MessagesUI": ["@@isomer+//:swift_ui", "@@isomer+//:foundation"],
    },
)
swift_deps.configure_package(
    name = "swift_sql",
    target_deps = {
        "SwiftSQL": ["@@isomer+//:foundation"],
    },
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_agent_ui",
    "swiftpkg_swift_sql",
)

# The builder's own signing values (the Apple team), from .bazelrc.user.
signing = use_extension("//tools/signing:extension.bzl", "signing")
use_repo(signing, "pipeline_signing")

# --- Isomer: SwiftUI for the web, Android, Linux and Windows, from the
# --- project's registry. This repository's libraries import SwiftUI and
# --- Foundation through //:swift_ui and //:foundation, isomer's per-platform
# --- labels: Apple's own on Apple platforms, Isomer's elsewhere.
bazel_dep(name = "isomer", version = "0.39.1")

# flatbuffers' released Swift BUILD glob misses Sources/FlatBuffers/Vectors/,
# and its Foundation use breaks under WASI: isomer's patches, which a root
# module repeats (an override is the root's alone).
bazel_dep(name = "flatbuffers", version = "25.12.19")
single_version_override(
    module_name = "flatbuffers",
    patch_strip = 1,
    patches = [
        "//third_party/patches:flatbuffers_foundation_wasi.patch",
        "//third_party/patches:flatbuffers_swift_vectors.patch",
    ],
    version = "25.12.19",
)

# flatbuffers' transitive rules_foreign_cc 0.10.1 fails to load under Bazel 9.
single_version_override(
    module_name = "rules_foreign_cc",
    version = "0.15.1",
)

# isomer's Android cross-compile toolchains. The extension insists on a
# root-level android.sdk tag even when only the NDK's cc toolchains are used.
bazel_dep(name = "hermetic_android_toolchains", version = "0.1.1")
# Any Linux takes Google's x86_64 SDK and NDK tools: an arm64 Linux (a
# container on a Mac) runs them under Rosetta, with x86_64 glibc beside its
# own (Visor's agent image has it), as isomer and visor patch it.
single_version_override(
    module_name = "hermetic_android_toolchains",
    patch_strip = 1,
    patches = ["//third_party/patches:hermetic_android_toolchains_linux_any_cpu.patch"],
)

android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android")
android.sdk(
    build_tools_version = "35.0.0",
    version = "35",
)
android.ndk(
    api_level = 28,
    version = "r27c",
)
use_repo(android, "androidndk", "androidsdk")

# isomer's web-app macro declares sh_binary dev servers.
bazel_dep(name = "rules_shell", version = "0.8.0")

# The swift.org toolchain with the WebAssembly and Android Swift SDKs.
swift = use_extension("@rules_swift//swift:extensions.bzl", "swift")
swift.toolchain(
    name = "swift_toolchain",
    swift_version = "6.3.2",
)
swift.wasm_sdk()
# The wasi-threads SDK beside it, for the WasmKit Visor's reactor
# as isomer declares it (its toolchains are registered whether used or not).
swift.wasm_sdk(
    sha256 = "dda937f5f31d69ebf8609b430f3818020f5f3e683a72dd91d0875d8c814e0c48",
    threads = True,
    url = "https://github.com/AttilaTheFun/swift/releases/download/threads-sdk-6.3.2-1/swift-6.3.2-RELEASE_wasm-threads.artifactbundle.tar.gz",
)
swift.android_sdk()
use_repo(swift, "swift_toolchain")

register_toolchains(
    "@swift_toolchain//:cc_toolchain_wasm32_xcode",
    "@swift_toolchain//:swift_toolchain_wasm32_xcode",
    "@swift_toolchain//:cc_toolchain_wasm32_threads_xcode",
    "@swift_toolchain//:swift_toolchain_wasm32_threads_xcode",
    "@swift_toolchain//:swift_toolchain_android_aarch64_xcode",
    "@swift_toolchain//:swift_toolchain_android_x86_64_xcode",
)

# A Linux host (GitHub's hosted runners): swift.org's ubuntu24.04 toolchain
# as the exec Swift toolchain, with the same wasm and Android SDKs. Fetched
# only when a Linux host resolves them.
register_toolchains(
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04",
    "@swift_toolchain//:cc_toolchain_wasm32_threads_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_wasm32_threads_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04",
    "@swift_toolchain//:swift_toolchain_exec_ubuntu24.04-aarch64",
    "@swift_toolchain//:cc_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_wasm32_ubuntu24.04-aarch64",
    "@swift_toolchain//:cc_toolchain_wasm32_threads_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_wasm32_threads_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_aarch64_ubuntu24.04-aarch64",
    "@swift_toolchain//:swift_toolchain_android_x86_64_ubuntu24.04-aarch64",
)

bazel_dep(name = "rules_android", version = "0.7.3")

rules_android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
override_repo(rules_android_sdk, "androidsdk")

register_toolchains(
    "@androidndk//:all",
    "@androidsdk//:all",
)

bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_kotlin", version = "2.2.2")
bazel_dep(name = "rules_python", version = "2.0.2")

# The transitively resolved rules_go is too old for Bazel 9, and
# rules_applecross's graph (llvm) raises it to 0.62, and gazelle to 0.51,
# whose repository tooling needs Go 1.24.12 or later: the hermetic Go SDK
# below, so the host's Go is never consulted.
bazel_dep(name = "rules_go", version = "0.62.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.12")

# rules_android's Maven graph, declared from the root (rules_jvm_external
# reads a lock file only from the root module), merging isomer's
# contribution; the lock is a copy of isomer's.
#   REPIN=1 bazel run @rules_android_maven//:pin
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "rules_android_maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    known_contributing_modules = [
        "rules_android",
        "isomer",
    ],
    lock_file = "//third_party/maven:rules_android_maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
    version_conflict_policy = "pinned",
)
use_repo(maven, "rules_android_maven")

android_tools = use_extension("@isomer//tools/android:extensions.bzl", "android_tools")
use_repo(
    android_tools,
    "android_build_tools",
    "android_emulator",
    "android_platform_jar",
    "android_platform_tools",
    "android_system_image",
    "hermetic_jdk",
    "kotlin_compiler",
)
