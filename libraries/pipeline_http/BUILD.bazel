load("//tools/swift:defs.bzl", "STRICT_SWIFT")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# HTTP and HTTPS over Network.framework, as Applications Server speaks
# it: a port listened on, each request read (an upload streamed to a file)
# and answered.
swift_library(
    name = "pipeline_http",
    copts = STRICT_SWIFT,
    srcs = glob(["Sources/*.swift"]),
    module_name = "PipelineHTTP",
    # Network and Security: the Mac's alone, until the server runs on Linux
    # (docs/APPLICATIONS_PLAN.md). On Linux `//libraries/...` passes over it,
    # and over what depends on it; //server builds it for the Mac there too.
    target_compatible_with = ["@platforms//os:macos"],
)
