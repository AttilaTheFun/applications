load("@rules_swift//swift:swift.bzl", "swift_library")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "pipeline_snapshots_macos",
    testonly = True,
    # The Mac's alone (AppKit): on Linux, as a wildcard would build it, it is
    # not.
    target_compatible_with = ["@platforms//os:macos"],
    srcs = ["//libraries/pipeline_snapshots:shared"] + glob(["Sources/*.swift"]),
    copts = STRICT_SWIFT,
    module_name = "PipelineSnapshots",
)
