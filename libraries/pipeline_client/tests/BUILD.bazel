load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("//tools/swift:defs.bzl", "STRICT_SWIFT")

# How an app chooses a path to its server: every path asked at once, this
# computer before the LAN before the tailnet, never one waited out before
# the next is asked; and why each that did not answer did not. The
# paths are stand-ins that answer or fail when told, so the choice is tested
# apart from any network.
#
#   bazel test //libraries/pipeline_client/tests:pipeline_client_tests
#   bazel test //libraries/pipeline_client/tests:pipeline_client_tests_mac   # the same as a Mac .xctest bundle
swift_library(
    name = "pipeline_client_tests_lib",
    testonly = True,
    srcs = glob(["*.swift"]),
    copts = STRICT_SWIFT,
    module_name = "PipelineClientTests",
    deps = [
        "//libraries/pipeline_client",
    ],
)

swift_test(
    name = "pipeline_client_tests",
    deps = [":pipeline_client_tests_lib"],
)

# The same tests on a Mac, where the library's Apple side is compiled in: an
# .xctest bundle, built on Linux in CI and run on a slot of OS Server's
# primary Mac (tools/ci/mac_vm_tests.sh).
macos_unit_test(
    name = "pipeline_client_tests_mac",
    minimum_os_version = "15.0",
    # Run by a Mac: on Linux, `bazel test //...` passes over it, unless it's
    # built for a Mac slot to run (//tools/ci:mac_tests_anywhere).
    target_compatible_with = select({
        "//tools/ci:build_mac_tests_anywhere": [],
        "//conditions:default": ["@platforms//os:macos"],
    }),
    deps = [":pipeline_client_tests_lib"],
)
